{
  "name": "@kontourai/aidlc-kit",
  "version": "0.1.0",
  "description": "AI-DLC methodology as a portable Flow Agents kit",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontourai/aidlc-kit.git"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "kit.json",
    "flows/",
    "skills/",
    "docs/",
    "scripts/",
    "evals/",
    "upstream/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./scripts/runtime.mjs",
    "./kit.json": "./kit.json",
    "./run": "./scripts/run.mjs",
    "./executor": "./scripts/executor.mjs",
    "./compile": "./scripts/compile.mjs"
  },
  "dependencies": {
    "@kontourai/flow": "5.2.0",
    "@kontourai/flow-agents": "8.1.0",
    "@kontourai/plumb": "0.2.0",
    "@kontourai/surface": "5.0.0"
  },
  "scripts": {
    "test": "node --test evals/*.test.mjs",
    "check": "node scripts/compile.mjs --check && node scripts/compare.mjs method && node evals/public-flow-conformance.mjs",
    "test:package": "node --test test/package-install.test.mjs",
    "docs:check": "npx -y github:kontourai/corpus#340b66fc8f723c1babe35fce8240c82cd196b0db corpus check",
    "docs:build": "npx -y github:kontourai/corpus#340b66fc8f723c1babe35fce8240c82cd196b0db corpus build"
  },
  "bin": {
    "kontour-aidlc": "scripts/cli.mjs"
  },
  "devDependencies": {
    "@kontourai/survey": "8.2.0"
  },
  "peerDependencies": {
    "@kontourai/survey": ">=8.2.0 <9"
  },
  "peerDependenciesMeta": {
    "@kontourai/survey": {
      "optional": true
    }
  }
}
